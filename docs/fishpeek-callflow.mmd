flowchart TD
    load["加载插件，挂接 EventSystem.Update"] --> toggle["F10 首次开启检测与输出"]
    toggle --> tables["初始化鱼竿、鱼种与天气信息"]
    toggle --> discover["低频发现控制器，缓存弱句柄"]
    discover --> poll["主线程逐帧读取 fishJustEncounteredParam"]
    poll --> valid{"有可解析的新遭遇？"}
    valid -- 否 --> poll
    valid -- 是 --> queue["去重，放入限长队列"]
    queue --> scope{"输出开启且符合 F11 范围？"}
    scope -- 否 --> skip["不输出本次提示"]
    scope -- 是 --> context["解析玩家、钓点、鱼竿与环境"]
    tables --> context
    context --> candidates["档案或分类白名单，等级与地点筛选，环境评分"]
    candidates --> display["显示等级与候选，无候选时保留基础提示"]
