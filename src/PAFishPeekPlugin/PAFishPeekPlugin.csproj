<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>PAFishPeekPlugin</AssemblyName>
    <RootNamespace>PAFishPeekPlugin</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PAAutoDeploy Condition="'$(PAAutoDeploy)' == ''">false</PAAutoDeploy>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="FishPeekPlugin.cs" />
    <Compile Include="FishPeekPlugin.ContextPrediction.cs" />
    <Compile Include="FishLevelData.cs" />
    <Compile Include="FishContextData.cs" />
    <Compile Include="RodFishCategoryData.cs" />
    <Compile Include="BuiltInExactRodProfilesData.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx.Core">
      <HintPath>$(PA_GameRoot)\BepInEx\core\BepInEx.Core.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx.Unity.Common">
      <HintPath>$(PA_GameRoot)\BepInEx\core\BepInEx.Unity.Common.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>$(PA_GameRoot)\BepInEx\core\BepInEx.Unity.IL2CPP.dll</HintPath>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(PA_GameRoot)\BepInEx\core\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="MonoMod.RuntimeDetour">
      <HintPath>$(PA_GameRoot)\BepInEx\core\MonoMod.RuntimeDetour.dll</HintPath>
    </Reference>
    <Reference Include="Il2CppInterop.Common">
      <HintPath>$(PA_GameRoot)\BepInEx\core\Il2CppInterop.Common.dll</HintPath>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(PA_GameRoot)\BepInEx\core\Il2CppInterop.Runtime.dll</HintPath>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(PA_GameRoot)\BepInEx\interop\Il2Cppmscorlib.dll</HintPath>
    </Reference>
    <Reference Include="Il2CppSystem">
      <HintPath>$(PA_GameRoot)\BepInEx\interop\Il2CppSystem.dll</HintPath>
    </Reference>
    <Reference Include="Recreate.PartyAnimals">
      <HintPath>$(PA_GameRoot)\BepInEx\interop\Recreate.PartyAnimals.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(PA_GameRoot)\BepInEx\interop\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(PA_GameRoot)\BepInEx\interop\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(PA_GameRoot)\BepInEx\interop\UnityEngine.InputLegacyModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(PA_GameRoot)\BepInEx\interop\UnityEngine.TextRenderingModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(PA_GameRoot)\BepInEx\interop\UnityEngine.UIModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(PA_GameRoot)\BepInEx\interop\UnityEngine.UI.dll</HintPath>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(PA_GameRoot)\BepInEx\interop\Unity.TextMeshPro.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
